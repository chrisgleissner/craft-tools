# Publish only reviewed build infrastructure. Child app repos stay independent.
/*
!/.gitignore
!/README.md
!/repositories.txt
!/craft
!/run-craft
!/install-shortcuts.sh
!/tests/
/tests/*
!/tests/test_craft_tool.py
!/tests/test_launch_scripts.py
!/tests/test_smoke_apps.py
!/tests/smoke_apps.py
!/tests/test_discovery.py
!/tests/test_setup.py
!/scripts/
/scripts/*
!/scripts/discover_repos.py
!/scripts/setup-prerequisites.sh
!/scripts/package-release.sh
!/tests/test_package.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/test.yml
!/.github/workflows/release.yml
